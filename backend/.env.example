# eMazao backend configuration — copy to .env and fill in.
#   cp .env.example .env
#
# Never commit the filled-in .env: it carries the live database password and the
# key that protects sellers' national ID numbers, and git history is permanent —
# a secret committed once cannot be un-committed, only rotated.

PORT=9000
NODE_ENV=production

# --- Database ---
# MongoDB Atlas connection string (contains the DB password).
# Atlas → Network Access must allow this server's IP.
MONGO_URI=

# --- Auth ---
# Generate each with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Public origin of the frontend. Socket.IO checks requests against this, so a
# wrong value silently breaks live messages, calls and live-stream viewer counts.
CLIENT_URL=https://your-domain.example

# --- Cloudinary (image & video uploads, incl. KYC documents) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments: ClickPesa (Tanzania mobile money) ---
# Dashboard → Developers → Applications.
PAYMENT_PROVIDER=clickpesa
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=
# Enable checksums on the ClickPesa app, then paste that exact key here.
# Blank  = webhooks are accepted unsigned (anyone who finds the URL can mark
#          orders paid) and the server refuses to start in production.
# Wrong  = every genuine webhook fails its signature check, so payments are
#          collected but never confirmed. It must match ClickPesa exactly.
CLICKPESA_CHECKSUM_KEY=

# --- Identity & risk (KYC / AML) ---
# Keys the national-ID hash. TREAT AS PERMANENT: changing it orphans every
# stored hash and means re-collecting ID from every verified seller.
# Generate once with: openssl rand -hex 32   — then back it up somewhere safe.
NIDA_HASH_KEY=
# Salts hashed device/IP fingerprints used for self-dealing detection.
# openssl rand -hex 32
FINGERPRINT_SALT=
# Optional self-hosted CPU vision service (OpenCV / MediaPipe) for the liveness
# challenge. Leave blank and liveness reports "unavailable" rather than passing.
BIOMETRIC_SERVICE_URL=
BIOMETRIC_SERVICE_KEY=

# --- Email (OTP, password reset, order notifications) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=eMazao <noreply@emazao.com>

# --- Optional ---
OPENAI_API_KEY=
