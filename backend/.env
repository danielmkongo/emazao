# --- Identity & risk (KYC / AML) ---
# Keys the national-ID hash. PERMANENT once live: changing it orphans every
# stored hash and means re-collecting every seller's ID.
# Generate with: openssl rand -hex 32
NIDA_HASH_KEY=5887545ed551aadf62c303fe63e072d2bcc592f9bba687899a74fcd6af4f0d54
# Salts hashed device/IP fingerprints used for self-dealing detection.
FINGERPRINT_SALT=
