# eMazao reverse proxy — copy to /etc/nginx/sites-available/emazao, edit the
# server_name, then: ln -s ... sites-enabled/ && nginx -t && systemctl reload nginx
#
# The Node process serves BOTH the API and the built frontend (see the
# express.static block in backend/src/app.ts), so everything proxies to one
# upstream. Keep this port equal to PORT in backend/.env.

upstream emazao_app {
    server 127.0.0.1:9000;
    keepalive 32;
}

server {
    listen 80;
    server_name your-domain.example www.your-domain.example;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name your-domain.example www.your-domain.example;

    # certbot --nginx manages these two lines
    ssl_certificate     /etc/letsencrypt/live/your-domain.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.example/privkey.pem;

    # Reels and KYC documents are uploaded through the API; the 1m default
    # rejects them as 413 before multer ever sees the request.
    client_max_body_size 100M;

    # Socket.IO (live messages, calls, viewer counts) needs the Upgrade headers
    # and a long read timeout, or idle sockets get cut every 60s and the client
    # falls back to reconnect loops.
    location /socket.io/ {
        proxy_pass http://emazao_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Vite fingerprints files in dist/assets, so their contents can never change
    # under a given name — cache them hard.
    location /assets/ {
        proxy_pass http://emazao_app;
        proxy_set_header Host $host;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        proxy_pass http://emazao_app;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;

        # index.html names the current hashed bundles. If a proxy or browser
        # holds an old copy, a correct deploy still renders the old UI — so this
        # one file must never be cached.
        location = /index.html {
            proxy_pass http://emazao_app;
            proxy_set_header Host $host;
            add_header Cache-Control "no-store, must-revalidate";
        }
    }
}
